# Environment — copy to .env and fill in real values

# PostgreSQL
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/talentlens

# LLM / Ollama-compatible AI config
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_MODEL=qwen3.5:9b
LLM_EMBED_MODEL=nomic-embed-text
RANKING_PROVIDER=llm

# JWT — use a random 32+ char string
JWT_SECRET=changeme_use_a_long_random_string_here_32chars

# Server
PORT=3001
CLIENT_URL=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:3001
