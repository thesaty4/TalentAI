# Environment — copy to .env and fill in real values

# PostgreSQL
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/talentlens

# Llama / Ollama-compatible AI config
LLAMA_BASE_URL=http://localhost:11434
LLAMA_API_KEY=
LLAMA_MODEL=llama3
LLAMA_EMBED_MODEL=nomic-embed-text
RANKING_PROVIDER=llama

# JWT — use a random 32+ char string
JWT_SECRET=changeme_use_a_long_random_string_here_32chars

# Server
PORT=3001
CLIENT_URL=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:3001
