# Environment — copy to .env and fill in real values

# PostgreSQL
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/talentlens

# Gemini (hackathon AI Sandbox or Google AI Studio key)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
# GEMINI_BASE_URL=https://your-sandbox-proxy.example.com

# JWT — use a random 32+ char string
JWT_SECRET=changeme_use_a_long_random_string_here_32chars

# Server
PORT=3001
CLIENT_URL=http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:3001
