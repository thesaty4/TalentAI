# Environment variables — copy to .env and fill in real values

# PostgreSQL connection string
DATABASE_URL=postgres://postgres:yourpassword@localhost:5432/talentlens

# Gemini API key (hackathon AI Sandbox or Google AI Studio key)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model name (default: gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Optional: custom Gemini base URL for hackathon sandbox proxy
# GEMINI_BASE_URL=https://your-sandbox-proxy.example.com

# JWT signing secret — use a long random string in production
JWT_SECRET=changeme_use_a_long_random_string_here

# Server port
PORT=3001

# Client URL (used for CORS)
CLIENT_URL=http://localhost:5173
